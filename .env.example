# Database connection URL (Default menggunakan Docker MariaDB Fin.IQ):
DATABASE_URL="mysql://finiq_user:finiq_user_password_2026@finiq-db:3306/defaultdb"
# Atau jika diakses dari luar docker container (misal Drizzle CLI di host):
# DATABASE_URL="mysql://finiq_user:finiq_user_password_2026@127.0.0.1:3306/defaultdb"
# Atau jika menggunakan Aiven / Cloud MySQL eksternal:
# DATABASE_URL="mysql://avnadmin:YOUR_PASSWORD@YOUR_HOST:12551/defaultdb"

# NextAuth / Auth secret
NEXTAUTH_SECRET="finiq-secret-key-32-chars-minimum-token"
NEXTAUTH_URL="http://localhost:3000"

# Demo User ID for single-tenant local seeding
DEMO_USER_ID="default-user-uuid-1"

# Base currency setting (Default IDR)
NEXT_PUBLIC_DEFAULT_CURRENCY="IDR"

# Google Gemini API Key (free via https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
