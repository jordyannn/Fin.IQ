# Neon Postgres / Vercel Postgres connection URL
DATABASE_URL="postgres://neondb_owner:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# NextAuth / Auth secret
NEXTAUTH_SECRET="finiq-secret-key-32-chars-minimum-token"
NEXTAUTH_URL="http://localhost:3000"

# Demo User ID for single-tenant local seeding
DEMO_USER_ID="default-user-uuid-1"

# Base currency setting (Default IDR)
NEXT_PUBLIC_DEFAULT_CURRENCY="IDR"
